{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug C",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/sql-right",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "ASAN_OPTIONS", "value": "abort_on_error=1:detect_leaks=0" },
        { "name": "UBSAN_OPTIONS", "value": "print_stacktrace=1" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build"
    }
  ]
}